config ZMK_BEHAVIOR_OS_LAYER
    bool "Auto layer switching based on BLE profile (OS detection)"
    default n

config CUSTOM_BATTERY_TYPIST
    bool "Enable battery level typing behavior"
    default y
    depends on ZMK_BATTERY_REPORTING
    depends on !ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL

config ZMK_LAYER_STATUS_GATT
    bool "Expose active layer state via custom BLE GATT service (for LineaStudio overlay)"
    default n
    depends on ZMK_BLE
    depends on !ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL

config ZMK_USB_HOST_OS_DETECTION
    bool "Detect wired USB host OS and switch default layer"
    default n
    depends on ZMK_USB
    depends on !ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL

config ZMK_USB_HOST_OS_DETECTION_SETTLE_MS
    int "Settle delay (ms) before classifying the wired USB host OS"
    default 250
    depends on ZMK_USB_HOST_OS_DETECTION

# Debug/measurement only (future iPad fingerprinting). The usb_dc_ep_read --wrap
# is owned by usb_host_os.c; enabling this only adds the ring buffer + the
# &usb_fp_type readout behavior, never a second wrap.
config ZMK_USB_FP_CAPTURE
    bool "USB host fingerprint capture (measurement/debug build)"
    default n
    depends on ZMK_USB
    depends on !ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL
